# ==============================================================
# StreamScope OTT Analytics - Environment Configuration Template
# ==============================================================
# Copy this file to '.env' and update with your local credentials.
# Note: '.env' is ignored by Git and will never be committed.

# Application Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=streamscope
DB_USER=streamscope_user
DB_PASSWORD=your_password_here

# Root Administrator (Used only during initial schema & user creation)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
