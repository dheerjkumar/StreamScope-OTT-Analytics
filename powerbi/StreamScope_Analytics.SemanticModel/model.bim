{
  "compatibilityLevel": 1606,
  "model": {
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"_Measures\",\"MonthlyPerformance\",\"ContentPerformance\",\"ChurnByDimension\",\"UserSegments\",\"DimUsers\",\"DimPlans\",\"DimContent\",\"FactSubscriptions\",\"FactViewingSessions\"]"
      }
    ],
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "relationships": [
      {
        "name": "rel_subs_users",
        "fromTable": "FactSubscriptions",
        "fromColumn": "user_id",
