        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Monthly Active Viewers (MAU)"
                }
              },
              "queryRef": "_Measures.Monthly Active Viewers (MAU)"
