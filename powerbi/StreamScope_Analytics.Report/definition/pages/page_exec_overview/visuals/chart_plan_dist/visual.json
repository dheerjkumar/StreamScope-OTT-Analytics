{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.15.0/schema.json",
  "name": "chart_plan_dist",
  "position": {
    "x": 30,
    "y": 570,
    "z": 9,
    "width": 600,
    "height": 490
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimPlans"
                    }
                  },
                  "Property": "plan_name"
                }
              },
              "queryRef": "DimPlans.plan_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Active Paid Subscribers"
                }
              },
              "queryRef": "_Measures.Active Paid Subscribers"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Subscription Plan Distribution'"
                }
              }
            }
          }
        }
      ]
    }
  }
}